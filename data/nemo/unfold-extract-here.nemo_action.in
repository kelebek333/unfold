[Nemo Action]
Name=Extract Here
Comment=Extract the selected archive to the current position
Exec=unfold --extract-here -- %F
Icon-Name=xsi-extract-archive-symbolic
Selection=notnone
Mimetypes=application/gzip;application/vnd.comicbook+zip;application/vnd.ms-cab-compressed;application/vnd.rar;application/x-7z-compressed;application/x-archive;application/x-bzip2;application/x-bzip-compressed-tar;application/x-compressed-tar;application/x-cpio;application/x-iso9660-image;application/x-lzma;application/x-lzma-compressed-tar;application/x-rar;application/x-tar;application/x-xz;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/zip;application/zstd;application/x-zip;application/x-zip-compressed;application/x-rar-compressed;application/x-gzip;application/bzip2;application/x-bzip;application/x-gtar;application/x-tarz;application/x-compress;application/java-archive;application/x-java-archive;application/x-war;application/x-ear;application/vnd.android.package-archive;application/x-cabinet;application/x-arj;application/x-lha;application/x-lhz;application/x-ar;application/x-cd-image;application/x-ms-wim;application/x-xar;
Dependencies=unfold;
Quote=double
Conditions=exec test -w %P;
UriScheme=file
